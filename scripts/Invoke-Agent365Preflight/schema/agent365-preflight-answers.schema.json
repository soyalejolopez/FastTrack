{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/FastTrack/blob/master/scripts/Invoke-Agent365Preflight/schema/agent365-preflight-answers.schema.json",
  "title": "Microsoft Agent 365 pre-flight manual answers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "answers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": ["1.0", "1.1", "2.0"]
    },
    "sourceReportId": { "type": "string" },
    "assessmentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "modifiedAtUtc": { "type": "string", "format": "date-time" },
    "bundleId": { "type": "string" },
    "baseRevision": { "type": "string" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "draft": { "type": "boolean" },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "answer"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A365-(?:MANUAL-[0-9]{3}|[A-Z]+-[0-9]{3}|PROFILE-[A-Z0-9]+)$"
          },
          "answer": {
            "enum": ["Yes", "No", "NotApplicable"]
          },
          "owner": {
            "type": "string"
          },
          "evidenceReference": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "answeredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "justification": {
            "type": "string"
          },
          "binding": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "modifiedAtUtc": { "type": "string", "format": "date-time" },
          "reviewDecision": { "enum": ["Retain", "Revalidate", "Edit"] },
          "baseHash": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "answer": {
                  "const": "Yes"
                }
              }
            },
            "then": {
              "required": ["owner", "evidenceReference"],
              "properties": {
                "owner": {
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                },
                "evidenceReference": {
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "answer": {
                  "const": "NotApplicable"
                }
              }
            },
            "then": {
              "required": ["justification"],
              "properties": {
                "justification": {
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": "2.0" } } },
    "then": {
      "required": ["sourceReportId", "assessmentFingerprint", "generatedAtUtc", "modifiedAtUtc", "bundleId", "contentHash"],
      "properties": { "answers": { "items": { "required": ["binding", "answeredAtUtc", "modifiedAtUtc", "reviewDecision"] } } }
    }
  }]
}
