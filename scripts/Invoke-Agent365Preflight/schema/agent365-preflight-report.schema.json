{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/FastTrack/blob/master/scripts/Invoke-Agent365Preflight/schema/agent365-preflight-report.schema.json",
  "title": "Microsoft Agent 365 technical pre-flight report",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ToolVersion",
    "GeneratedAtUtc",
    "RuleSetVersion",
    "RuleReviewDate",
    "Stage",
    "Profiles",
    "Collectors",
    "Verdict",
    "Tenant",
    "Coverage",
    "Authentication",
    "Results",
    "Actions",
    "ManualAttestations",
    "Drift",
    "Sources",
    "CollectionIssues",
    "Runtime"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "1.0"
    },
    "ToolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "GeneratedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "RuleSetVersion": {
      "type": "string"
    },
    "RuleReviewDate": {
      "type": "string",
      "format": "date"
    },
    "Stage": {
      "enum": ["Pilot", "Production"]
    },
    "Profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "Collectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "Sanitized": {
      "type": "boolean"
    },
    "BetaEnabled": {
      "type": "boolean"
    },
    "FixtureMode": {
      "type": "boolean"
    },
    "Verdict": {
      "type": "object",
      "required": ["Label", "Summary", "BlockerCount", "ActionRequiredCount", "AuthorizationGapCount"],
      "properties": {
        "Label": {
          "enum": ["Ready for pilot", "Blocked", "Incomplete", "Technical pre-flight complete"]
        },
        "Summary": {
          "type": "string"
        },
        "BlockerCount": {
          "type": "integer",
          "minimum": 0
        },
        "ActionRequiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "AuthorizationGapCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Tenant": {
      "type": "object",
      "required": [
        "DisplayName",
        "TenantId",
        "PrimaryDomain",
        "Cloud",
        "CommercialAvailability",
        "TargetAssertion"
      ],
      "properties": {
        "DisplayName": {},
        "TenantId": {},
        "PrimaryDomain": {},
        "Cloud": {
          "type": "string"
        },
        "CommercialAvailability": {},
        "TargetAssertion": {
          "type": "object",
          "required": [
            "Requested",
            "Expected",
            "Method",
            "Matched",
            "ActualTenantId",
            "MatchedVerifiedDomain"
          ],
          "properties": {
            "Requested": {
              "type": "boolean"
            },
            "Expected": {},
            "Method": {
              "enum": ["NotRequested", "Unverified", "TenantId", "VerifiedDomain"]
            },
            "Matched": {},
            "ActualTenantId": {},
            "MatchedVerifiedDomain": {}
          }
        }
      }
    },
    "Coverage": {
      "type": "object"
    },
    "Authentication": {
      "type": "object",
      "required": [
        "Mode",
        "Account",
        "RequestedScopes",
        "GrantedScopes",
        "MissingScopes",
        "UseDeviceCode",
        "ReusedExistingContext",
        "PermissionsUsed",
        "Notes"
      ],
      "properties": {
        "Mode": {
          "type": "string"
        },
        "Account": {},
        "RequestedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "GrantedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "MissingScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "UseDeviceCode": {
          "type": "boolean"
        },
        "ReusedExistingContext": {
          "type": "boolean"
        },
        "PermissionsUsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Notes": {
          "type": "array"
        }
      }
    },
    "Results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "Actions": {
      "type": "array"
    },
    "ManualAttestations": {
      "type": "array"
    },
    "Drift": {
      "type": "object"
    },
    "Sources": {
      "type": "array"
    },
    "CollectionIssues": {
      "type": "array"
    },
    "Runtime": {
      "type": "object",
      "required": [
        "PowerShellVersion",
        "Platform",
        "DurationSeconds",
        "AuditWindowDays",
        "AuditQueryTimeoutSeconds",
        "OutputFiles"
      ],
      "properties": {
        "PowerShellVersion": {
          "type": "string"
        },
        "Platform": {
          "type": "string"
        },
        "DurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "AuditWindowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "AuditQueryTimeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 900
        },
        "OutputFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "Id",
        "Title",
        "Pillar",
        "Area",
        "Profiles",
        "Applicability",
        "Status",
        "Expected",
        "Observed",
        "EvidenceMethod",
        "EvidenceTimeUtc",
        "RequiredPermission",
        "RequiredRole",
        "Remediation",
        "DocsUrl",
        "RuleReviewDate"
      ],
      "properties": {
        "Id": {
          "type": "string",
          "pattern": "^A365-(?:[A-Z]+-[0-9]{3}|PROFILE-[A-Z0-9]+)$"
        },
        "Title": {
          "type": "string"
        },
        "Pillar": {
          "enum": ["Observe", "Govern", "Secure"]
        },
        "Area": {
          "type": "string"
        },
        "Profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Applicability": {
          "type": "string"
        },
        "Status": {
          "enum": ["Passed", "Blocker", "ActionRequired", "Advisory", "ManualValidation", "NotApplicable", "NotAuthorized", "Error"]
        },
        "Expected": {},
        "Observed": {},
        "EvidenceMethod": {
          "type": "string"
        },
        "EvidenceTimeUtc": {
          "type": "string",
          "format": "date-time"
        },
        "RequiredPermission": {
          "type": "string"
        },
        "RequiredRole": {
          "type": "string"
        },
        "Remediation": {
          "type": "string"
        },
        "DocsUrl": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/"
        },
        "RuleReviewDate": {
          "type": "string",
          "format": "date"
        },
        "Details": {},
        "IsSensitive": {
          "type": "boolean"
        }
      }
    }
  }
}
