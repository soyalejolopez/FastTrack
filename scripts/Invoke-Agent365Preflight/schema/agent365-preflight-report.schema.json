{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/FastTrack/blob/master/scripts/Invoke-Agent365Preflight/schema/agent365-preflight-report.schema.json",
  "title": "Microsoft Agent 365 technical pre-flight report",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ReportId",
    "ToolVersion",
    "GeneratedAtUtc",
    "RuleSetVersion",
    "RuleReviewDate",
    "GuidanceVersion",
    "GuidanceReviewDate",
    "Stage",
    "Profiles",
    "Collectors",
    "AssessmentScope",
    "CollectionScope",
    "RunSpecification",
    "ConfigurationManifest",
    "RuleFreshness",
    "TrustReceipt",
    "SourceProvenance",
    "Verdict",
    "PassCriteria",
    "PathToReady",
    "Tenant",
    "Coverage",
    "Authentication",
    "Results",
    "Actions",
    "ManualAttestations",
    "ManuallyAttestableGates",
    "Resume",
    "Rerun",
    "Drift",
    "Sources",
    "CollectionIssues",
    "Runtime"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "2.0"
    },
    "ReportId": {
      "type": "string",
      "pattern": "^Agent365Preflight-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}$"
    },
    "ToolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "GeneratedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "RuleSetVersion": {
      "type": "string"
    },
    "RuleReviewDate": {
      "type": "string",
      "format": "date"
    },
    "GuidanceVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "GuidanceReviewDate": {
      "type": "string",
      "format": "date"
    },
    "Stage": {
      "enum": ["Pilot", "Production"]
    },
    "Profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "Collectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "AssessmentScope": {
      "type": "object",
      "required": ["Version", "Fingerprint", "Stage", "Profiles", "TargetSites", "RolePolicy", "Requirements", "ExcludedRequirements"],
      "properties": {
        "Version": { "const": "2.0" },
        "Fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "Stage": { "enum": ["Pilot", "Production"] },
        "Profiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "TargetSites": { "type": "array", "items": { "type": "string" } },
        "RolePolicy": { "enum": ["ActiveRoles", "PIM"] },
        "ExcludedRequirements": { "type": "array", "items": { "type": "string" } },
        "Requirements": { "type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["Id", "Applicable", "Reason", "Collector"],
          "properties": { "Id": { "type": "string" }, "Applicable": { "type": "boolean" }, "Reason": { "type": "string" }, "Collector": { "type": "string" } }
        } }
      }
    },
    "CollectionScope": {
      "type": "object",
      "required": ["Version", "Requested", "Mode", "Ran", "Simulated"],
      "properties": { "Version": { "const": "2.0" }, "Requested": { "type": "array", "items": { "type": "string" } }, "Mode": { "enum": ["Synthetic fixture", "Live adapters"] } }
    },
    "RunSpecification": {
      "type": ["object", "null"],
      "required": ["Version", "ResourceVersion", "SourceProvenance", "Stage", "Profiles", "AssessmentScope", "Collectors", "TargetSites", "TenantTarget", "AuthenticationMode", "ClientId", "DelegatedClientId", "Cloud", "UseDeviceCode", "AuditWindowDays", "AuditQueryTimeoutSeconds", "ConfigurationManifest", "FixtureMode", "IncludeSanitizedCopy"],
      "properties": {
        "Version": { "const": "2.0" },
        "ResourceVersion": { "type": "string" },
        "Stage": { "enum": ["Pilot", "Production"] },
        "Profiles": { "type": "array", "items": { "type": "string" } },
        "Collectors": { "type": "array", "items": { "type": "string" } },
        "TargetSites": { "type": "array", "items": { "type": "string" } },
        "AuthenticationMode": { "enum": ["InteractiveDelegated", "CertificateAppOnly"] },
        "Cloud": { "const": "Commercial" },
        "UseDeviceCode": { "type": "boolean" },
        "AuditWindowDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "AuditQueryTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 900 }
      }
    },
    "ConfigurationManifest": {
      "type": "object", "required": ["Version", "Files", "Engine", "SemanticsHash"],
      "properties": { "Version": { "const": "2.0" }, "Files": { "type": "array", "minItems": 5 }, "SemanticsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "RuleFreshness": { "type": "object", "required": ["Owner", "ValidThrough", "ReviewCadenceDays", "State"] },
    "TrustReceipt": { "type": "object", "required": ["Version", "Mode", "TenantTarget", "ClientId", "ApplicationName", "Permissions", "Grants", "QueryPersistence", "Consent", "TokenCaveat", "Offboarding"] },
    "SourceProvenance": { "type": "object", "required": ["SourceCommit", "SourceRepository", "BuiltAtUtc", "SourceState", "ManifestSHA256", "PublisherAuthentication"] },
    "Sanitized": {
      "type": "boolean"
    },
    "BetaEnabled": {
      "type": "boolean"
    },
    "FixtureMode": {
      "type": "boolean"
    },
    "Verdict": {
      "type": "object",
      "required": ["Label", "Summary", "BlockerCount", "ActionRequiredCount", "AuthorizationGapCount", "ErrorCount", "RequiredManualUnresolvedCount"],
      "properties": {
        "Label": {
          "enum": ["Ready for pilot", "Blocked", "Incomplete", "Technical pre-flight complete"]
        },
        "Summary": {
          "type": "string"
        },
        "BlockerCount": {
          "type": "integer",
          "minimum": 0
        },
        "ActionRequiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "AuthorizationGapCount": {
          "type": "integer",
          "minimum": 0
        },
        "ErrorCount": {
          "type": "integer",
          "minimum": 0
        },
        "RequiredManualUnresolvedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PassCriteria": {
      "$ref": "#/$defs/passCriteria"
    },
    "PathToReady": {
      "type": "object",
      "required": ["IsReady", "GateCounts", "Phases", "Items"],
      "properties": {
        "IsReady": {
          "type": "boolean"
        },
        "GateCounts": {
          "$ref": "#/$defs/passCriteria"
        },
        "Phases": {
          "type": "array"
        },
        "Items": {
          "type": "array"
        }
      }
    },
    "Tenant": {
      "type": "object",
      "required": [
        "DisplayName",
        "TenantId",
        "PrimaryDomain",
        "Cloud",
        "CommercialAvailability",
        "TargetAssertion"
      ],
      "properties": {
        "DisplayName": {},
        "TenantId": {},
        "PrimaryDomain": {},
        "Cloud": {
          "type": "string"
        },
        "CommercialAvailability": {},
        "TargetAssertion": {
          "type": "object",
          "required": [
            "Requested",
            "Expected",
            "Method",
            "Matched",
            "ActualTenantId",
            "MatchedVerifiedDomain"
          ],
          "properties": {
            "Requested": {
              "type": "boolean"
            },
            "Expected": {},
            "Method": {
              "enum": ["NotRequested", "Unverified", "TenantId", "VerifiedDomain"]
            },
            "Matched": {},
            "ActualTenantId": {},
            "MatchedVerifiedDomain": {}
          }
        }
      }
    },
    "Coverage": {
      "type": "object"
    },
    "Authentication": {
      "type": "object",
      "required": [
        "Mode",
        "Account",
        "RequestedScopes",
        "GrantedScopes",
        "MissingScopes",
        "UseDeviceCode",
        "ReusedExistingContext",
        "PermissionsUsed",
        "Notes"
      ],
      "properties": {
        "Mode": {
          "type": "string"
        },
        "Account": {},
        "RequestedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "GrantedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "MissingScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "UseDeviceCode": {
          "type": "boolean"
        },
        "ReusedExistingContext": {
          "type": "boolean"
        },
        "PermissionsUsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Notes": {
          "type": "array"
        }
      }
    },
    "Results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "Actions": {
      "type": "array"
    },
    "ManualAttestations": {
      "type": "array"
    },
    "ManuallyAttestableGates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manuallyAttestableGate"
      }
    },
    "Resume": {
      "type": "object",
      "required": [
        "Available",
        "ReportId",
        "ScriptPath",
        "Command",
        "SanitizedCommand",
        "AnswerFileName",
        "AnswerSearchPaths"
      ],
      "properties": {
        "Available": { "type": "boolean" },
        "ReportId": {
          "type": "string",
          "pattern": "^Agent365Preflight-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}$"
        },
        "ScriptPath": { "type": "string" },
        "Command": { "type": "string" },
        "SanitizedCommand": { "type": "string" },
        "AnswerFileName": {
          "type": "string",
          "pattern": "^Agent365Preflight-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}-answers\\.json$"
        },
        "AnswerSearchPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "Rerun": {
      "type": "object",
      "required": [
        "Command",
        "SanitizedCommand",
        "TenantTarget",
        "AnswersPath",
        "PreviousResultPath",
        "OutputPath",
        "IncludeSanitizedCopy",
        "Stage",
        "Profiles",
        "Collectors",
        "AuditWindowDays",
        "AuditQueryTimeoutSeconds",
        "UseDeviceCode"
      ]
    },
    "Drift": {
      "type": "object",
      "required": [
        "HasBaseline",
        "BaselineGeneratedAtUtc",
        "Regressions",
        "ResolvedBlockers",
        "ResolvedRequiredActions",
        "Changed"
      ],
      "properties": {
        "HasBaseline": {
          "type": "boolean"
        },
        "BaselineGeneratedAtUtc": {},
        "Regressions": {
          "type": "array"
        },
        "ResolvedBlockers": {
          "type": "array"
        },
        "ResolvedRequiredActions": {
          "type": "array"
        },
        "Changed": {
          "type": "array"
        }
      }
    },
    "Sources": {
      "type": "array"
    },
    "CollectionIssues": {
      "type": "array"
    },
    "Runtime": {
      "type": "object",
      "required": [
        "PowerShellVersion",
        "Platform",
        "DurationSeconds",
        "AuditWindowDays",
        "AuditQueryTimeoutSeconds",
        "OutputFiles"
      ],
      "properties": {
        "PowerShellVersion": {
          "type": "string"
        },
        "Platform": {
          "type": "string"
        },
        "DurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "AuditWindowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "AuditQueryTimeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 900
        },
        "OutputFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "passCriteria": {
      "type": "object",
      "required": [
        "BlockerCount",
        "ActionRequiredCount",
        "NotAuthorizedCount",
        "ErrorCount",
        "RequiredManualUnresolvedCount",
        "IsSatisfied",
        "Summary"
      ],
      "properties": {
        "BlockerCount": {
          "type": "integer",
          "minimum": 0
        },
        "ActionRequiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "NotAuthorizedCount": {
          "type": "integer",
          "minimum": 0
        },
        "ErrorCount": {
          "type": "integer",
          "minimum": 0
        },
        "RequiredManualUnresolvedCount": {
          "type": "integer",
          "minimum": 0
        },
        "IsSatisfied": {
          "type": "boolean"
        },
        "Summary": {
          "type": "string"
        }
      }
    },
    "guidance": {
      "type": "object",
      "required": [
        "Intent",
        "WhyItMatters",
        "WhoShouldAnswer",
        "YesCriteria",
        "EvidenceToRetain",
        "VerificationSteps",
        "NoRemediation",
        "NotApplicableAllowed",
        "NotApplicableGuidance",
        "PublicSources",
        "ReviewDate",
        "SearchText"
      ],
      "properties": {
        "Intent": { "type": "string", "minLength": 1 },
        "WhyItMatters": { "type": "string", "minLength": 1 },
        "WhoShouldAnswer": { "type": "string", "minLength": 1 },
        "YesCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "EvidenceToRetain": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "VerificationSteps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["Order", "Title", "Instruction", "Location"],
            "properties": {
              "Order": { "type": "integer", "minimum": 1 },
              "Title": { "type": "string", "minLength": 1 },
              "Instruction": { "type": "string", "minLength": 1 },
              "Location": { "type": "string", "minLength": 1 }
            }
          }
        },
        "NoRemediation": { "type": "string", "minLength": 1 },
        "NotApplicableAllowed": { "type": "boolean" },
        "NotApplicableGuidance": { "type": "string", "minLength": 1 },
        "PublicSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["Title", "Url"],
            "properties": {
              "Title": { "type": "string", "minLength": 1 },
              "Url": {
                "type": "string",
                "pattern": "^https://learn\\.microsoft\\.com/"
              }
            }
          }
        },
        "ReviewDate": { "type": "string", "format": "date" },
        "SearchText": { "type": "string", "minLength": 1 }
      }
    },
    "manuallyAttestableGate": {
      "type": "object",
      "required": [
        "Id",
        "Title",
        "Status",
        "Required",
        "AllowNotApplicable",
        "NoStatus",
        "EvidenceNeeded",
        "DocsUrl",
        "Profiles",
        "RequiredRole",
        "Observed",
        "IsSensitive",
        "Guidance"
      ],
      "properties": {
        "Id": { "type": "string", "pattern": "^A365-(?:[A-Z]+-[0-9]{3}|PROFILE-[A-Z0-9]+)$" },
        "Title": { "type": "string" },
        "Status": {
          "enum": ["Passed", "Blocker", "ActionRequired", "Advisory", "ManualValidation", "NotApplicable", "NotAssessed", "NotAuthorized", "Error"]
        },
        "Required": { "type": "boolean" },
        "AllowNotApplicable": { "type": "boolean" },
        "NoStatus": { "enum": ["Blocker", "ActionRequired"] },
        "EvidenceNeeded": { "type": "string" },
        "DocsUrl": { "type": "string", "pattern": "^https://learn\\.microsoft\\.com/" },
        "Profiles": { "type": "array", "items": { "type": "string" } },
        "RequiredRole": { "type": "string" },
        "Observed": {},
        "IsSensitive": { "type": "boolean" },
        "Guidance": { "$ref": "#/$defs/guidance" }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "Id",
        "Title",
        "Pillar",
        "Area",
        "Profiles",
        "Applicability",
        "Status",
        "Expected",
        "Observed",
        "EvidenceMethod",
        "EvidenceTimeUtc",
        "RequiredPermission",
        "RequiredRole",
        "Remediation",
        "DocsUrl",
        "RuleReviewDate",
        "ManualAttestable",
        "AttestationRequired",
        "AttestationDefinition",
        "Attestation"
      ],
      "properties": {
        "Id": {
          "type": "string",
          "pattern": "^A365-(?:[A-Z]+-[0-9]{3}|PROFILE-[A-Z0-9]+)$"
        },
        "Title": {
          "type": "string"
        },
        "Pillar": {
          "enum": ["Observe", "Govern", "Secure"]
        },
        "Area": {
          "type": "string"
        },
        "Profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Applicability": {
          "type": "string"
        },
        "Status": {
          "enum": ["Passed", "Blocker", "ActionRequired", "Advisory", "ManualValidation", "NotApplicable", "NotAssessed", "NotAuthorized", "Error"]
        },
        "Expected": {},
        "Observed": {},
        "EvidenceMethod": {
          "type": "string"
        },
        "EvidenceTimeUtc": {
          "type": "string",
          "format": "date-time"
        },
        "RequiredPermission": {
          "type": "string"
        },
        "RequiredRole": {
          "type": "string"
        },
        "Remediation": {
          "type": "string"
        },
        "DocsUrl": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/"
        },
        "RuleReviewDate": {
          "type": "string",
          "format": "date"
        },
        "ManualAttestable": {
          "type": "boolean"
        },
        "AttestationRequired": {
          "type": "boolean"
        },
        "AttestationDefinition": {
              "type": ["object", "null"],
              "required": ["Required", "AllowNotApplicable", "NoStatus", "EvidenceNeeded", "RequiredRole", "Guidance", "Source"],
              "properties": {
                "Required": { "type": "boolean" },
                "AllowNotApplicable": { "type": "boolean" },
                "NoStatus": { "enum": ["Blocker", "ActionRequired"] },
                "EvidenceNeeded": { "type": "string" },
                "RequiredRole": { "type": "string" },
                "Guidance": { "$ref": "#/$defs/guidance" },
                "Source": { "type": "string" },
                "Binding": { "type": "string" }
              }
        },
        "Attestation": {
          "type": ["object", "null"]
        },
        "Details": {},
        "IsSensitive": {
          "type": "boolean"
        }
      }
    }
  }
}
